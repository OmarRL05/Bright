# Sin prefijo /api: /decide, /decisions, /status, /replays, /zones, /shocks
# estan montados en la raiz del backend (ver backend/main.py), no bajo /api
# (ese prefijo solo lo usan los endpoints de simulacion que siguen sin
# implementar en api/routes.py). Si esto trae /api, el dashboard entero
# entero se queda pegado en "sin backend" -- ya paso.
NEXT_PUBLIC_API_URL=http://localhost:8000

# /ws/state sigue siendo un stub que nunca envia nada (ver
# src/hooks/useSimulation.ts, ya no lo usa nadie -- el dashboard real lee por
# REST via src/hooks/useAgent.ts). Se deja documentada por si se retoma.
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/state
